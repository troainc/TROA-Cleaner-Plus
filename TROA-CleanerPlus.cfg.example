<?xml version="1.0"?>
<!--
  TROA Cleaner+ example configuration (v1.3.0).

  HOW TO USE THIS FILE
  - The live file is created next to the plugin as "TROA-CleanerPlus.cfg" on first start.
  - This example shows every setting WITH real sample entries so nothing is left to guess.
  - The list sections below (ProtectedSteamIds, ProtectionZones, ScheduledEvents, QuietHours, ...)
    contain SAMPLE entries. Edit them to your server, or delete the entries you do not want.
    To make a list empty, remove the inner entries (e.g. <ProtectionZones></ProtectionZones>).
  - Edit the live .cfg and save it (auto-reloads), or run "!cleanerplusadmin reload". No restart.

  SAFETY: GlobalDryRun ships ON. Nothing is deleted until you set it to false. Run
  "!cleanerplus scan" to preview exactly what would be removed first.
-->
<CleanerConfig xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- ===================== MASTER ===================== -->
  <!-- Master switch for the whole plugin. -->
  <Enabled>true</Enabled>
  <!-- Name shown in chat broadcasts and logs. -->
  <DisplayName>Cleaner+</DisplayName>
  <!-- When true, modules only REPORT what they would remove; nothing is deleted. -->
  <GlobalDryRun>true</GlobalDryRun>
  <!-- Grids/objects newer than this (minutes) are never touched. -->
  <GracePeriodMinutes>15</GracePeriodMinutes>
  <!-- Removals per simulation tick. Keep low so a big sweep never stalls the server. -->
  <MaxRemovalsPerTick>2</MaxRemovalsPerTick>

  <!-- ===================== WARNINGS / MESSAGES ===================== -->
  <BroadcastWarnings>true</BroadcastWarnings>
  <BroadcastSummary>true</BroadcastSummary>
  <!-- Seconds-before-run at which a countdown warning is broadcast. Edit/add/remove entries. -->
  <WarningLeadSeconds>
    <int>60</int>
    <int>30</int>
    <int>10</int>
  </WarningLeadSeconds>
  <!-- Player-facing text. Placeholders: {DisplayName} {Module} {Seconds} {Count} {MinBlocks} {NoCleanTag} -->
  <WarningMessageTemplate>{DisplayName}: {Module} cleanup in {Seconds}s.</WarningMessageTemplate>
  <SummaryMessageTemplate>{DisplayName}: cleaned {Count} {Module}.</SummaryMessageTemplate>
  <ShowKeepHintOnScan>true</ShowKeepHintOnScan>
  <ScanMaxLines>25</ScanMaxLines>
  <KeepHintMessage>To keep a grid: give it a Beacon, build it past {MinBlocks} blocks, rename it from the default name, or add {NoCleanTag} to its name.</KeepHintMessage>
  <RecoveryHintMessage>Removed grids are recoverable: check Gridvault+ with !gridvault find &lt;name&gt;, or ask staff with !cleaner request.</RecoveryHintMessage>
  <!-- Leave empty to auto-generate the !cleanerplus policy text; set text here to override it. -->
  <PolicyMessageOverride></PolicyMessageOverride>
  <!-- Optional locale file (key=value) that overrides the message templates above. Blank = English.
       Example: <LocaleFile>Plugins\TROA-CleanerPlus\locales\de.lang</LocaleFile> -->
  <LocaleFile></LocaleFile>

  <!-- ===================== GRIDVAULT+ / BACKUP-BEFORE-DELETE ===================== -->
  <EnableGridvaultIntegration>true</EnableGridvaultIntegration>
  <RequireGridvaultBackupBeforeDelete>true</RequireGridvaultBackupBeforeDelete>
  <GridvaultCleanupReasonPrefix>TROA Cleaner+</GridvaultCleanupReasonPrefix>
  <!-- If Gridvault+ is not installed, capture removed grids into Cleaner+'s own local Cleanup Grids
       folder (under TROA-CleanerPlusData) instead. -->
  <EnableLocalBackupFallback>true</EnableLocalBackupFallback>

  <!-- ===================== TROA GRID KEEP POLICY ===================== -->
  <!-- A grid survives cleanup only if it meets ALL enabled requirements below. -->
  <RequireBeaconToKeep>true</RequireBeaconToKeep>
  <MinBlocksToKeep>25</MinBlocksToKeep>
  <RequireRenamedToKeep>true</RequireRenamedToKeep>
  <!-- Optional PCU keep rule: a grid under this PCU also fails the policy. RequirePcuToKeep=false
       disables it; MinPcuToKeep 0 = ignore. -->
  <RequirePcuToKeep>false</RequirePcuToKeep>
  <MinPcuToKeep>0</MinPcuToKeep>
  <!-- Names treated as "not renamed" (a trailing number like "Large Grid 1234" still matches). -->
  <DefaultGridNamePatterns>
    <string>Large Grid</string>
    <string>Small Grid</string>
    <string>Static Grid</string>
    <string>Large Ship</string>
    <string>Small Ship</string>
    <string>Platform</string>
    <string>Unnamed Grid</string>
  </DefaultGridNamePatterns>

  <!-- ===================== PROTECTION / WHITELIST (always keeps) ===================== -->
  <!-- Put this tag anywhere in a grid's name to protect it. -->
  <NoCleanTag>[NOCLEAN]</NoCleanTag>
  <!-- Auto-protect any grid that contains a Safe Zone block (faction HQ style). -->
  <Protect_SafeZoneGrids>true</Protect_SafeZoneGrids>
  <!-- SAMPLES: keep any grid whose name contains one of these (case-insensitive). Edit or delete. -->
  <ProtectedNameSubstrings>
    <string>HQ</string>
    <string>Event</string>
  </ProtectedNameSubstrings>
  <!-- SAMPLES: keep any grid owned by these Steam64 IDs. Replace with real IDs or delete. -->
  <ProtectedSteamIds>
    <unsignedLong>76561190000000000</unsignedLong>
  </ProtectedSteamIds>
  <!-- SAMPLES: keep any grid owned by these faction tags. Edit or delete. -->
  <ProtectedFactionTags>
    <string>TROA</string>
  </ProtectedFactionTags>
  <!-- SAMPLES: keep any grid containing a block whose type/subtype contains one of these. Edit/delete. -->
  <KeepIfBlockPresent>
    <string>SafeZone</string>
  </KeepIfBlockPresent>
  <!-- SAMPLES: spherical GPS regions that are never cleaned. Edit coordinates/radius or delete. -->
  <ProtectionZones>
    <ProtectionZone>
      <Name>Trade Hub</Name>
      <X>0</X>
      <Y>0</Y>
      <Z>0</Z>
      <RadiusMeters>5000</RadiusMeters>
    </ProtectionZone>
  </ProtectionZones>

  <!-- ===================== FLOATING OBJECTS MODULE ===================== -->
  <FloatingObjects_Enabled>true</FloatingObjects_Enabled>
  <!-- Interval | RealTime | CommandOnly -->
  <FloatingObjects_Mode>Interval</FloatingObjects_Mode>
  <FloatingObjects_IntervalMinutes>15</FloatingObjects_IntervalMinutes>
  <FloatingObjects_MaxAgeMinutes>30</FloatingObjects_MaxAgeMinutes>
  <!-- Keep stacks of at least this size (valuable dropped cargo). 0 = age only. -->
  <FloatingObjects_KeepStackAtLeast>0</FloatingObjects_KeepStackAtLeast>
  <!-- Never remove an object within this many meters of an online player. 0 = ignore. -->
  <FloatingObjects_MinDistanceFromPlayers>0</FloatingObjects_MinDistanceFromPlayers>

  <!-- ===================== GRID CLEANUP MODULE ===================== -->
  <Grids_Enabled>true</Grids_Enabled>
  <Grids_Mode>Interval</Grids_Mode>
  <Grids_IntervalMinutes>30</Grids_IntervalMinutes>
  <!-- Include static (anchored) grids? Off by default. -->
  <Grids_IncludeStatic>false</Grids_IncludeStatic>
  <Grids_RemoveOwnerless>true</Grids_RemoveOwnerless>
  <Grids_RemoveNoFunctional>true</Grids_RemoveNoFunctional>
  <!-- Spare any eligible grid within this many meters of an online player. 0 = ignore. -->
  <Grids_MinDistanceFromPlayers>0</Grids_MinDistanceFromPlayers>
  <!-- Only clean an eligible owned grid if its owner has been offline this many days. 0 = ignore. -->
  <Grids_OwnerOfflineDays>0</Grids_OwnerOfflineDays>
  <!-- Treat mechanically connected subgrids (rotor/piston) as one unit. -->
  <Grids_TreatConnectedAsGroup>true</Grids_TreatConnectedAsGroup>

  <!-- ===================== DEAD-CHARACTER MODULE (optional) ===================== -->
  <Corpses_Enabled>false</Corpses_Enabled>
  <Corpses_Mode>Interval</Corpses_Mode>
  <Corpses_IntervalMinutes>20</Corpses_IntervalMinutes>
  <Corpses_MaxAgeMinutes>30</Corpses_MaxAgeMinutes>

  <!-- ===================== PER-FACTION / PER-ZONE POLICY OVERRIDES ===================== -->
  <!-- SAMPLES: each override changes only the fields it sets. Match = FactionTag or ZoneName (a zone
       match beats a faction match). MinBlocksToKeep/IntervalMinutes -1 = inherit. Flags = Inherit|On|Off.
       Edit or delete. -->
  <PolicyOverrides>
    <PolicyOverride>
      <Match>ZoneName</Match>
      <Value>Trade Hub</Value>
      <MinBlocksToKeep>100</MinBlocksToKeep>
      <IntervalMinutes>-1</IntervalMinutes>
      <RequireBeaconToKeep>Off</RequireBeaconToKeep>
      <Enabled>Inherit</Enabled>
    </PolicyOverride>
    <PolicyOverride>
      <Match>FactionTag</Match>
      <Value>NPC</Value>
      <MinBlocksToKeep>-1</MinBlocksToKeep>
      <IntervalMinutes>-1</IntervalMinutes>
      <RequireBeaconToKeep>Inherit</RequireBeaconToKeep>
      <Enabled>Off</Enabled>
    </PolicyOverride>
  </PolicyOverrides>

  <!-- ===================== DISCORD AUDIT WEBHOOK ===================== -->
  <EnableAuditWebhook>false</EnableAuditWebhook>
  <!-- Full Discord webhook URL. Keep private; it is never written to logs. -->
  <AuditWebhookUrl></AuditWebhookUrl>
  <WebhookName>Cleaner+</WebhookName>
  <SendStartupWebhookTest>true</SendStartupWebhookTest>
  <WebhookOnPass>true</WebhookOnPass>
  <WebhookOnDigest>true</WebhookOnDigest>
  <!-- Concealment effectiveness report (coverage %, concealed/revealed). -->
  <WebhookOnConceal>false</WebhookOnConceal>

  <!-- ===================== SCHEDULED DIGEST ===================== -->
  <Digest_Enabled>false</Digest_Enabled>
  <Digest_IntervalMinutes>60</Digest_IntervalMinutes>
  <Digest_ToAdminsInGame>true</Digest_ToAdminsInGame>
  <Digest_ToWebhook>true</Digest_ToWebhook>

  <!-- ===================== GRID CONCEALMENT (EXPERIMENTAL, off by default) =====================
       Reversibly pauses idle grids (removes them from simulation, not deletion) to reclaim sim
       speed; reveals them when a player approaches; reveals everything on world unload. Never
       conceals static, protected, or (unless RevealOnSpawn) spawn-capable medical/cryo grids. -->
  <Conceal_Enabled>false</Conceal_Enabled>
  <Conceal_Mode>Interval</Conceal_Mode>
  <Conceal_IntervalMinutes>5</Conceal_IntervalMinutes>
  <!-- A grid must be idle (no player within reveal radius) this long before it is concealed. -->
  <Conceal_InactiveMinutes>30</Conceal_InactiveMinutes>
  <!-- A player within this many meters conceals/reveals grids. -->
  <Conceal_RevealRadiusMeters>2000</Conceal_RevealRadiusMeters>
  <Conceal_MaxPerTick>2</Conceal_MaxPerTick>
  <Conceal_SkipStatic>true</Conceal_SkipStatic>
  <!-- Allow concealing medbay/cryo grids and reveal them when a player spawns/logs in. -->
  <Conceal_RevealOnSpawn>false</Conceal_RevealOnSpawn>
  <!-- A Programmable Block / Remote Control "Cleaner+ Keep Alive" action holds a grid hot on demand. -->
  <Conceal_KeepAliveAction>true</Conceal_KeepAliveAction>
  <Conceal_KeepAliveMinutes>30</Conceal_KeepAliveMinutes>
  <!-- Keep a grid hot when it has an antenna owned by an online player. -->
  <Conceal_KeepAliveAntenna>true</Conceal_KeepAliveAntenna>

  <!-- ===================== SELF-HEALING PERFORMANCE ===================== -->
  <!-- Adaptive intervals scale by sim health (healthy=longer, degraded=shorter). Emergency
       concealment kicks in when sim ratio stays below the threshold. ProfilerMetricsFile can point
       at TROA Profiler+'s prometheus.prom / latest.json to source sim speed; blank reads the engine. -->
  <Adaptive_Enabled>false</Adaptive_Enabled>
  <Adaptive_MinIntervalMinutes>5</Adaptive_MinIntervalMinutes>
  <Adaptive_MaxIntervalMinutes>120</Adaptive_MaxIntervalMinutes>
  <Adaptive_HealthySimSpeed>0.95</Adaptive_HealthySimSpeed>
  <Adaptive_DegradedSimSpeed>0.8</Adaptive_DegradedSimSpeed>
  <ProfilerMetricsFile></ProfilerMetricsFile>
  <Conceal_EmergencyEnabled>false</Conceal_EmergencyEnabled>
  <Conceal_EmergencyThreshold>0.6</Conceal_EmergencyThreshold>
  <Conceal_EmergencyMaxPerTick>8</Conceal_EmergencyMaxPerTick>

  <!-- ===================== PLAYER-FAIR RETENTION ===================== -->
  <Warn_Enabled>true</Warn_Enabled>
  <Warn_LeadMinutes>10</Warn_LeadMinutes>
  <Warn_ToOwnerChat>true</Warn_ToOwnerChat>
  <Warn_ToWebhook>false</Warn_ToWebhook>
  <Warn_LoginGraceMinutes>15</Warn_LoginGraceMinutes>
  <!-- Placeholders: {DisplayName} {Grid} {Minutes} {Reason} {NoCleanTag} -->
  <Warn_MessageTemplate>{DisplayName}: your grid '{Grid}' is flagged for cleanup in ~{Minutes} min ({Reason}). Visit it or use !cleaner keep {Grid} to protect it.</Warn_MessageTemplate>
  <SelfKeep_Enabled>true</SelfKeep_Enabled>
  <SelfKeep_MaxPerPlayer>2</SelfKeep_MaxPerPlayer>
  <SelfKeep_DurationHours>72</SelfKeep_DurationHours>
  <Quota_Enabled>false</Quota_Enabled>
  <!-- 0 = unlimited. -->
  <Quota_MaxGrids>0</Quota_MaxGrids>
  <Quota_MaxPcu>0</Quota_MaxPcu>
  <!-- Flag a player's smallest grids for cleanup when over quota (keeps their biggest). -->
  <Quota_FlagOverLimitGrids>false</Quota_FlagOverLimitGrids>

  <!-- ===================== ADMIN CONTROL & SCHEDULING ===================== -->
  <Schedule_Enabled>false</Schedule_Enabled>
  <!-- SAMPLES: cleanup events at a local time-of-day. Days empty = every day. Module = a module key
       or "all". Edit or delete. Only run when Schedule_Enabled is true. -->
  <ScheduledEvents>
    <ScheduledEvent>
      <Name>Nightly Cleanup</Name>
      <Time>04:00</Time>
      <Days></Days>
      <Module>all</Module>
      <WarnSeconds>60</WarnSeconds>
    </ScheduledEvent>
  </ScheduledEvents>
  <QuietHours_Enabled>false</QuietHours_Enabled>
  <!-- SAMPLES: windows (local time) where automatic passes are suppressed. Days empty = every day.
       Windows may wrap past midnight (e.g. 22:00-06:00). Edit or delete. -->
  <QuietHours>
    <TimeWindow>
      <Start>18:00</Start>
      <End>23:00</End>
      <Days>Fri,Sat,Sun</Days>
    </TimeWindow>
  </QuietHours>
  <Undo_Enabled>true</Undo_Enabled>
  <Undo_WindowMinutes>30</Undo_WindowMinutes>
  <RestoreRequests_Enabled>true</RestoreRequests_Enabled>

  <!-- ===================== INSIGHT & ANALYTICS ===================== -->
  <History_Enabled>true</History_Enabled>
  <History_RetainDays>30</History_RetainDays>
  <Metrics_Enabled>false</Metrics_Enabled>
  <Dashboard_Enabled>false</Dashboard_Enabled>
  <Dashboard_IntervalMinutes>30</Dashboard_IntervalMinutes>

  <!-- ===================== PERSISTENT AGE + OWNER HELP + CLAIM (v1.4.0) ===================== -->
  <!-- Persist grid first-seen across restarts so grace/idle/offline stay accurate. -->
  <PersistGridAge>true</PersistGridAge>
  <!-- Send a temporary GPS marker to a flagged grid's owner (follows Warn_Enabled). -->
  <Warn_SendGps>true</Warn_SendGps>
  <!-- Let players claim a nearby ownerless grid with !cleaner claim. -->
  <Claim_Enabled>true</Claim_Enabled>
  <Claim_MaxDistanceMeters>200</Claim_MaxDistanceMeters>

  <!-- ===================== RESPAWN-SHIP MODULE (v1.4.0, off by default) ===================== -->
  <!-- Removes unclaimed (ownerless) default respawn ships/pods older than the age. -->
  <RespawnShips_Enabled>false</RespawnShips_Enabled>
  <RespawnShips_Mode>Interval</RespawnShips_Mode>
  <RespawnShips_IntervalMinutes>15</RespawnShips_IntervalMinutes>
  <RespawnShips_MaxAgeMinutes>30</RespawnShips_MaxAgeMinutes>
  <RespawnShips_MinDistanceFromPlayers>0</RespawnShips_MinDistanceFromPlayers>
  <!-- Grid names (substring match) treated as respawn ships. Edit or delete. -->
  <RespawnShip_NamePatterns>
    <string>Respawn</string>
    <string>RespawnShip</string>
    <string>Atmospheric Lander</string>
    <string>Escape Pod</string>
    <string>Rescue Ship</string>
  </RespawnShip_NamePatterns>

  <!-- ===================== NPC-GRID MODULE (v1.4.0, off by default) ===================== -->
  <!-- Removes stale NPC / pirate / cargo / encounter grids far from players. -->
  <NpcGrids_Enabled>false</NpcGrids_Enabled>
  <NpcGrids_Mode>Interval</NpcGrids_Mode>
  <NpcGrids_IntervalMinutes>30</NpcGrids_IntervalMinutes>
  <Npc_MaxAgeMinutes>60</Npc_MaxAgeMinutes>
  <Npc_MinDistanceFromPlayers>5000</Npc_MinDistanceFromPlayers>
  <!-- Keep NPC grids that contain any of these blocks (trade stations, safe zones). Edit or delete. -->
  <Npc_KeepIfBlockPresent>
    <string>Store</string>
    <string>SafeZone</string>
  </Npc_KeepIfBlockPresent>

  <!-- ===================== TROA-HANGAR AUTO-STOW (v1.4.0, off by default) ===================== -->
  <!-- Move an owned flagged grid into its owner's TROA-Hanger hangar instead of deleting it. -->
  <Stow_Enabled>false</Stow_Enabled>
  <Stow_OnlyOwnerOffline>true</Stow_OnlyOwnerOffline>

  <!-- ===================== GRADUATED ABANDONMENT LIFECYCLE (v1.4.0, off by default) =====================
       For OWNED grids only: warn (+GPS) -> depower reactors/thrusters -> dispose (stow or delete), on
       timers. Ownerless grids and other modules dispose immediately as usual. Supersedes the immediate
       owned-grid removal path when enabled. -->
  <Lifecycle_Enabled>false</Lifecycle_Enabled>
  <Lifecycle_Depower>true</Lifecycle_Depower>
  <Lifecycle_DepowerMinutes>60</Lifecycle_DepowerMinutes>
  <Lifecycle_DisposeMinutes>1440</Lifecycle_DisposeMinutes>
</CleanerConfig>
